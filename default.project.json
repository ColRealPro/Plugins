{
  "name": "Plugins",
  "globIgnorePaths": ["src/*/wally.toml", "src/*/wally.lock"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "plugins": {
        "$className": "Folder",
        "$path": "src"
      },
      "tests": {
        "$className": "Folder",
        "$path": "tests"
      },
      "Packages": {
        "$className": "Folder",
        "$path": "Packages"
      }
    }
  }
}
